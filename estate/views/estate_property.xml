<odoo>
    <record id="view_property_types_form" model="ir.ui.view">
        <field name="name">Property Type list</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_property_tags_form" model="ir.ui.view">
        <field name="name">Property Tag Form</field>
        <field name="model">estate.property.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_property_types" model="ir.actions.act_window">
        <field name="name">Action Property Type</field>
        <field name="res_model">estate.property.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_property_tags" model="ir.actions.act_window">
        <field name="name">Action Property Tag</field>
        <field name="res_model">estate.property.tag</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>