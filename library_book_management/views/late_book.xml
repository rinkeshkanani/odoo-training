<odoo noupdate="1">
    <!-- Scheduled Action -->
    <record id="ir_cron_late_book" model="ir.cron">
        <field name='name'>Library Book Schedular</field>
        <field name='model_id' ref='model_library_borrow'/>
        <field name='state'>code</field>
        <field name='code'>model.create_late_books</field>
        <field name='interval_time'>1</field>
        <field name="interval_type">day</field>
        <field name='priority'>5</field>
        <field name="user_id" ref='base.root_user'/>
        <field name="active" eval='True'/>
    </record>
</odoo>