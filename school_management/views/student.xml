<odoo>
    <record id="view_school_management_form" model="ir.ui.view">
        <field name="name">school_management.form</field>
        <field name="model">school_management.school_management</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="age"/>
                        <field name="email"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_management_list" model="ir.ui.view">
        <field name="name">school_management.list</field>
        <field name="model">school_management.school_management</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="age"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="action_school_management" model="ir.actions.act_window">
        <field name="name">School Management</field>
        <field name="res_model">school_management.school_management</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem id="menu_school_management_root" name="School Management"/>

    <menuitem id="menu_school_management"
          name="Students"
          parent="menu_school_management_root"
          action="action_school_management"/>
</odoo>
