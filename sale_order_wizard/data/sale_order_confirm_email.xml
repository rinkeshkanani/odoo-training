<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="email_confirm_sale_order" model="mail.template">
            <field name="name">Sale Order : Email Confirm Sale Order</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="email_to">{{object.partner_id.email}}</field>
            <field name="subject">Order Confirm {{ object.name }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div>
                    <p>Sale Order Confirm
                        <t t-out="object.name"/>
                    </p>
                </div>
                <div>
                    <table border="1" cellpadding="8" cellspacing="0" style="border-collapse:collapse; width:100%;">
                        <thead >
                            <tr>
                                <th>Total QTY</th>
                                <th>Total Amount</th>
                            </tr>
                        </thead>
                        <tbody >
                            <tr>
                                <td t-out="sum(line.product_uom_qty for line in object.order_line)"/>

                                <td>
                                    <t t-out="object.amount_total"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div>
                    <p>Payment Term:
                        <t t-out="object.payment_term_id.name"/>
                    </p>

                    <p>
                        <h5>Terms and Condition</h5>
                        <t t-out="object.note"/>
                    </p>

                    <p>Regards,</p>
                    <p>
                        <t t-out="user.name"/>
                    </p>
                </div>
            </field>
        </record>

    </data>
</odoo>