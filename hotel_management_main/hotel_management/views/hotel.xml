<odoo>
    <!-- ====================== HOTEL CUSTOMER ============================== -->
    <!-- List View -->
    <record id="view_hotel_management_list" model="ir.ui.view">
        <field name="name">hotel.management.list</field>
        <field name="model">hotel.management</field>
        <field name="arch" type="xml">
            <list>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="age"/>
                <field name="email"/>
                <field name="date_enter"/>
                <field name="date_exit"/>
                <field name="phone"/>
                <field name="is_assigned"/>
                <field name="amount"/>
                <field name="deposit_amount"/>
                <field name="amount_paid" widget="monetary"/>
                <field name="is_paid"/>
            </list>
        </field>
    </record>

    <!-- Search View -->

    <record id="view_hotel_management_search" model="ir.ui.view">
        <field name="name">hotel.management.search</field>
        <field name="model">hotel.management</field>
        <field name="arch" type="xml">
        <search>
            <field name="first_name"/>
            <field name="last_name"/>
            <field name="email"/>

            <filter string="Assigned"
                    name="filter_assigned"
                    domain="[('is_assigned','=',True)]"/>

            <filter string="Paid"
                    name="filter_paid"
                    domain="[('is_paid','=',True)]"/>

        </search>
        </field>
    </record>


    <!-- Form View -->
    <record id="view_hotel_management_form" model="ir.ui.view">
        <field name="name">hotel_management.form</field>
        <field name="model">hotel.management</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="first_name"/>
                        <field name="last_name"/>
                        <field name="age"/>
                        <field name="email"/>
                        <field name="date_enter"/>
                        <field name="date_exit"/>
                        <field name="phone"/>
                        <field name="is_assigned"/>
                        <field name="amount"/>
                        <field name="deposit_amount"/>
                        <field name="amount_paid" widget="monetary"/>
                        <field name="is_paid"/>
                    </group>

                    <notebook>

                        <!-- Rooms Tab -->
                        <page string="Rooms">

                            <field name="room_ids">
                            <list editable="bottom">
                                <field name="room_type"/>
                                <field name="room_no"/>
                                <field name="customer_name" readonly="1"/>
                            </list>
                            </field>
                        </page>
                        <!-- Customer Features Tab -->
                        <page string="Features">
                            <field name="feature_ids">
                                <list editable="bottom">
                                    <field name="feature_name"/>

                                </list>
                            </field>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hotel_management" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">hotel.management</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hotel_management_search"/>
    </record>


    <!-- ====================== HOTEL ROOM ============================== -->

    <!-- List View -->
    <record id="view_hotel_room_list" model="ir.ui.view">
        <field name="name">hotel.room.list</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <list>
                <field name="room_type"/>
                <field name="customer_name" readonly="1"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hotel_room_form" model="ir.ui.view">
        <field name="name">hotel.room.form</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="room_type"/>
                        <field name="customer_id"/>
                        <field name="customer_name" readonly="1"/>
                        <field name="feature_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hotel_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ====================== HOTEL FEATURE ============================== -->

    <!-- List View -->
    <record id="view_hotel_feature_list" model="ir.ui.view">
        <field name="name">hotel.feature.list</field>
        <field name="model">hotel.feature</field>
        <field name="arch" type="xml">
            <list>
                <field name="feature_name"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hotel_feature_form" model="ir.ui.view">
        <field name="name">hotel.feature.form</field>
        <field name="model">hotel.feature</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="feature_name"/>
                        <field name="document"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hotel_feature" model="ir.actions.act_window">
        <field name="name">Features</field>
        <field name="res_model">hotel.feature</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ====================== MENUS ============================== -->

    <menuitem id="menu_hotel_root"
              name="Hotel Management"
              sequence="10"/>

    <menuitem id="menu_hotel_customers"
              name="Customers"
              parent="menu_hotel_root"
              action="action_hotel_management"
              sequence="1"/>

    <menuitem id="menu_hotel_rooms"
              name="Rooms"
              parent="menu_hotel_root"
              action="action_hotel_room"
              sequence="2"/>

    <menuitem id="menu_hotel_features"
              name="Room Features"
              parent="menu_hotel_root"
              action="action_hotel_feature"
              sequence="3"/>

</odoo>

